# Lumière salon - n8n environment variables (SETUP.md step 6).
# Set these on the n8n instance (process environment / docker-compose / .env of
# n8n), then RESTART n8n. Never commit real values. Never reuse another
# bot's CLINIC_* values: the salon must have its own number and token.
# An unset variable fails closed: WhatsApp sends fail, Messenger rejects every request.

# WhatsApp Business (Meta > WhatsApp > API Setup) - the SALON's number
LUMIERE_WHATSAPP_PHONE_NUMBER_ID=
LUMIERE_WHATSAPP_ACCESS_TOKEN=

# Salon staff number that receives alerts and can send "!unmute <number>":
# digits only, with country code, no + (e.g. 34600000000)
LUMIERE_STAFF_CHAT_ID=

# Facebook Messenger (only if you use the Messenger workflow)
LUMIERE_MESSENGER_VERIFY_TOKEN=
LUMIERE_MESSENGER_APP_SECRET=
LUMIERE_MESSENGER_PAGE_ID=

# Instagram Direct (only if you use the Instagram workflow - INSTAGRAM-SETUP.md)
# Its own verify token (not the Messenger one). App Secret of the salon Meta app.
# Account ID = the salon Instagram professional account ID; both are REQUIRED
# (every request is rejected while either is unset).
LUMIERE_INSTAGRAM_VERIFY_TOKEN=
LUMIERE_INSTAGRAM_APP_SECRET=
LUMIERE_INSTAGRAM_ACCOUNT_ID=

# n8n must allow workflows to read them:
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false
